<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Icon cảnh báo đỏ -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_delete_icon_circle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="!"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="Xóa câu hỏi này?"
        android:textColor="#1A1A1A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Mô tả -->
    <TextView
        android:id="@+id/tvDeleteQuestionPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="#888888"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:text="Câu hỏi sẽ bị xóa vĩnh viễn và không thể khôi phục."
        android:textColor="#888888"
        android:textSize="14sp" />

    <!-- Hai nút -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Nút Quay lại (outline) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Quay lại"
            android:textColor="@color/primary"
            app:cornerRadius="25dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp" />

        <!-- Nút Xóa (đỏ solid) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteConfirm"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:text="Xóa"
            android:textColor="#FFFFFF"
            app:cornerRadius="25dp" />
    </LinearLayout>

</LinearLayout>

