<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/select_subject"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnSubject"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_option_default" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/select_question_count"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgQuestionCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">

        <RadioButton
            android:id="@+id/rbCount5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="5 câu (nhanh)" />

        <RadioButton
            android:id="@+id/rbCount10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 câu" />

        <RadioButton
            android:id="@+id/rbCount20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20 câu" />

        <RadioButton
            android:id="@+id/rbCountAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tất cả câu hỏi hiện có" />
    </RadioGroup>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartExam"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_start_exam"
        android:textSize="16sp"
        app:cornerRadius="12dp" />

</LinearLayout>

