<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="@string/welcome_message"
        android:textColor="@color/primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Module 3: Làm bài thi (Đinh Đức Nghĩa) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTakeExam"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="@string/btn_take_exam"
        android:textSize="16sp"
        app:cornerRadius="12dp" />

    <!-- Module 2: Quản lý ngân hàng câu hỏi (Lê Đức Mạnh) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuestionBank"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="@string/btn_question_bank"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:strokeColor="@color/primary" />

    <!-- Module 1: Lịch sử & Thống kê (Lê Đăng Hiệp) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHistory"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/btn_history"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:strokeColor="@color/accent" />

</LinearLayout>

