<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_quiz_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_quiz_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuizApp">

        <!-- Màn hình Đăng nhập / Đăng ký (SCR-01) — launcher -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình chính với Bottom Navigation (3 Fragment: Đề thi / Lịch sử / Câu hỏi) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Module 3: Chi tiết đề (SCR-03) -->
        <activity
            android:name=".ui.exam.ExamDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Module 3: Làm bài thi (SCR-04) -->
        <activity
            android:name=".ui.exam.ExamActivity"
            android:exported="false"
            android:label="@string/title_exam_in_progress" />

        <!-- Module 3: Kết quả (SCR-05) -->
        <activity
            android:name=".ui.exam.ResultActivity"
            android:exported="false"
            android:label="@string/title_exam_result" />

        <!-- Module 2: Thêm / Sửa câu hỏi (SCR-08) -->
        <activity
            android:name=".ui.question.QuestionEditActivity"
            android:exported="false"
            android:label="@string/title_question_edit"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Giữ lại để tránh build error nếu còn ref — sẽ không dùng -->
        <activity
            android:name=".ui.exam.ExamSetupActivity"
            android:exported="false" />

        <activity
            android:name=".ui.question.QuestionListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false" />

    </application>

</manifest>

